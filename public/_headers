# Applied by Cloudflare Pages to every static asset response.
# Kept deliberately conservative: a strict CSP is documented in README.md but not enabled
# here, because Tailwind injects inline <style> tags during Vite dev/HMR.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Pages does not apply this file to responses generated by Pages Functions - the rules above
# therefore never reach /api/ai-proxy. The relay sends its own `Cache-Control: no-store` from
# `shared/aiProxy.ts`, which is the only place it can be set. Nothing is declared here for /api/*.
