# Applied by Cloudflare Pages to every static asset response (never to `npm run dev`).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.cloudflareaccess.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://*.cloudflareaccess.com; frame-ancestors 'none'

# Pages does not apply this file to responses generated by Pages Functions - the rules above
# therefore never reach /api/ai-proxy. The relay sends its own `Cache-Control: no-store` from
# `shared/aiProxy.ts`, which is the only place it can be set. Nothing is declared here for /api/*.
