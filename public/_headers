# Applied by Cloudflare Pages to every asset response.
# Kept deliberately conservative: a strict CSP is documented in README.md but not enabled
# here, because Tailwind injects inline <style> tags during Vite dev/HMR.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The relay answers with whatever a provider said, including 401/429 bodies that describe an
# account state, so nothing here may be cached by a browser or a Pages edge node.
/api/*
  Cache-Control: no-store
